# Copy to .env for local dev. On Vercel, set these in the dashboard instead.

# --- your details (draft signature) ---
MY_NAME=Your Name
MY_HEADLINE=Virtual Assistant | Inbox, Scheduling & Admin Support
MY_PHONE=
MY_PORTFOLIO_URL=

# --- database ---
# Local dev leaves this blank (uses a local SQLite file).
# On Vercel set it to your Neon/Supabase Postgres URL, e.g.:
#   postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# --- auth / sessions ---
# Long random string. Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Comma-separated Google emails allowed to use the app (leave blank = allow any
# Google account that signs in — set this before going public!).
ALLOWED_EMAILS=you@gmail.com

# --- Google OAuth (Web client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL of the app. Local: http://localhost:8000  Prod: https://your-app.vercel.app
APP_BASE_URL=http://localhost:8000
# Usually leave blank (derived from APP_BASE_URL as <base>/api/auth/callback).
OAUTH_REDIRECT_URI=
# Where to send the browser after login. Local dev (Vite): http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- optional LLM drafts ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- optional extra job sources ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- send cap ---
DAILY_SEND_LIMIT=15
